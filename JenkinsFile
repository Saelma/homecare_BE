pipeline {
    agent any

    stages {
        stage('1. Checkout (코드 땡겨오기)') {
            steps {
                // itHub의 최신 코드를 서버로 긁어오기
                checkout scm
            }
        }
        stage('2. Build (빌드)') {
            steps {
                // 권한 부여 후 빌드 진행
                sh 'chmod +x gradlew'
                sh './gradlew clean build'
            }
        }
        stage('3. Deploy (확인)') {
            steps {
                echo '빌드 성공! 이제 파일이 build/libs/ 폴더에 생성되었습니다.'
            }
        }
    }
}